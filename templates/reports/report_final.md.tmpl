|---|---:|---:|---:|---|
| {{case.sections.report.organic.classes.0.name}} | {{case.sections.report.organic.classes.0.pixels}} | {{case.sections.report.organic.classes.0.det_md_px}} | {{case.sections.report.organic.classes.0.flag_obj}} / {{case.sections.report.organic.classes.0.objects}} | [{{case.sections.report.organic.classes.0.flag_obj_ci95.0|f3}}; {{case.sections.report.organic.classes.0.flag_obj_ci95.1|f3}}] |
